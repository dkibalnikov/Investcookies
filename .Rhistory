].join('');}")) %>%
e_draft("InvestCookies.ru", size = "80px", opacity = 0.2) %>%
e_datazoom(type = "slider", start = 50, end =100) %>%
e_legend(top = 30) %>%
e_axis_labels(x = "Месяц") %>%
e_title("Торговый баланс еврозоны", subtext = "Источник: ФРС США")
