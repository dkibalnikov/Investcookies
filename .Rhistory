#>  [6] 2.324789e-01 2.801373e-01 2.257146e-01 1.016863e-01 1.328754e-02
sum(pThetaGivenData_2)
pTheta
pDataGivenTheta
sum(pDataGivenTheta * pTheta_norm)
sum(pDataGivenTheta * pTheta)
pTheta = dbeta(theta, 10, 10)
sum(pTheta)
