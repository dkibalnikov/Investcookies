get_mass_effect <- function(mtrx, vec, n){
if(n > 2) {mtrx %*% get_mass_effect(mtrx, vec, n - 1)}
else{mtrx %*% vec}
}
vctr <- rep(0, 60)
vctr[36] <- 1
get_mass_effect(mtrx = b_mtrx, vec = vctr, n = 10)
get_mass_effect(mtrx = b_mtrx, vec = vctr, n = 15)
get_mass_effect(mtrx = b_mtrx, vec = vctr, n = 20)
