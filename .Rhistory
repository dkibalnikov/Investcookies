, target := (close_lag2 - close_lag1)/close_lag1]
train$stock_prices[!is.na(target), .(Target, target)] %>% colSums() %>% round(3)
train$stock_prices[, rank := frankv(target, ties.method = "first", order = -1) - 1, by = "Date"][1:5]  %>%
datatable(style = 'bootstrap4',  extensions = 'Responsive', options = list(pageLength = 10),
caption = "Rank calculation")
train$stock_prices[, .(max = max(rank), min = min(rank), qty = length(rank) - 1), by = "Date"] %>%
ggplot(aes(x = Date)) +
annotate("text_npc", npcx = .5, npcy = .5, label = "InvestCookies.ru", color = "#1D1E20", alpha = .9, size = 15) +
geom_line(aes(y = qty, col = "Quantity", lty = "Quantity"), alpha = .1, size = 6) +
geom_line(aes(y = max, col = "Max", lty = "Max")) +
geom_line(aes(y = min, col = "Min", lty = "Min")) +
scale_color_manual(values = c("Max" = my_pal[1], "Quantity" = my_pal[6], "Min" = my_pal[2])) +
scale_linetype_manual(values = c("Max" = 1, "Quantity" = 5, "Min" = 1)) +
labs(title = "Comparison max rank with quantity of stocks", y = "Max/Quantity")
train$stock_prices[, .(max = max(rank), min = min(rank), qty = length(rank) - 1), by = "Date"] %>%
ggplot(aes(x = Date)) +
