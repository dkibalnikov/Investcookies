library(thematic)
#library(plotly)
library(echarts4r)
library(tidyverse)
library(xts)
library(quantmod)
# library(data.table)
# library(collapse)
library(DT)
# library(janitor)
library(readxl)
# library(lubridate)
library(ggpp)
library(ggtext)
library(memoise)
library(ggrepel)
library(patchwork)
library(tidyxl)
library(unpivotr)
thematic_rmd(bg = "#1D1E20", accent = "cyan", fg = "grey90", font = font_spec("Roboto"), sequential = firatheme::firaPalette(100), qualitative = palette.colors(palette = "Tableau"))
# sysfonts::font_add_google("Roboto")
my_pal <- palette.colors(palette = "Tableau") %>% unname()
colorize <- function(color, text) {
sprintf("<a style='color:white; background:%s; border-radius:3px;padding: 2px' >%s</a>", color, text)
}
e_common(font_family = "Verdana", theme = "infographic")
p <- tibble(cor = cor, date = index(tickers)) %>%
mutate(Группы = cut(cor, breaks = 5, labels = c("Высокая отрицательная", "Отрицательная", "Слабая", "Положительная", "Высокая положительная")),
Год = str_sub(date, 1L, 4L)) %>%
drop_na() %>%
group_by(Год, Группы) %>%
summarise(n = n()) %>%
group_by(Год) %>%
mutate(prop = n/sum(n)) %>%
ggplot(aes(Год, n, fill = Группы)) +
geom_col(alpha = .6) +
labs(title = "Группы корреляций котировок нефти и курса рубля", fill = "", y = "Количество наблюдений") +
theme(text = element_text(color = "gray60"), legend.position = "bottom")
