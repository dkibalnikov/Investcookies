'<b>Барбершоп 2</b>: ' + Math.round(param2.value[1]) + ' тыс. руб.' + '<br/>',
].join('');}")) %>%
e_title(text = "Динамика выручки барбершопов") %>%
e_y_axis(name = "Выручка, тыс. руб.") %>%
e_x_axis(name = "День") %>%
e_legend(type = "scroll", selector = TRUE,  padding = 30) %>%
