res <- (4:10/10) |>
`names<-`(scales::percent(1-4:10/10)) |>
map_dfr(.id = "rate", ~est_impact(dm, .))
p1 <- filter(res, name == "...10") |>
ggplot(aes(year, value_add_est-value_add, col = rate, group = rate)) +
geom_line() +
scale_y_continuous(labels = scales::label_dollar(scale = 1e-6, prefix = "₽", suffix = " млрд.")) +
labs(title = "Влияние ограниченного экспорта нефтепродуктов на нефтеперерабатывающую отрасль",
x="Год", col = "Уровень\nограничений", y = "Добавленная стоимость")
p2 <- filter(res, name != "...10") |>
group_by(year, rate) |>
summarise(across(where(is.numeric), sum), .groups = "drop") |>
ggplot(aes(year, value_add_est-value_add, col = rate, group = rate)) +
geom_line() +
scale_y_continuous(labels = scales::label_dollar(scale = 1e-6, prefix = "₽", suffix = " млрд.")) +
labs(title = "Влияние ограниченного экспорта нефтепродуктов на прочие отрасли",
x="Год", col = "Уровень\nограничений", y = "Добавленная стоимость")
p1/p2 + patchwork::plot_layout(guides = "collect")
p3 <- filter(res, name == "...10") |>
ggplot(aes(year, inv_est-inv, col = rate, group = rate)) +
geom_line() +
scale_y_continuous(labels = scales::label_dollar(scale = 1e-6, prefix = "₽", suffix = " млрд.")) +
labs(title = "Влияние ограниченного экспорта нефтепродуктов на нефтеперерабатывающую отрасль",
