set.seed(123)
tst1 <- rnorm(100, 5, 1)
tst2 <- tst1*rnorm(100, -1, 1) + rnorm(100, 10, 1)
df <- tibble( a = tst1, b = tst2)
mdl1 <- lm(tst2 ~ tst1)
mdl2 <- lm(tst2 ~ tst1 + 0)
rsd1 <- tst2 - mdl1$fitted.values
rsd2 <- tst2 - mdl2$fitted.values
1 - sum(rsd1^2)/sum((tst2 - mean(tst2))^2)
1 - sum(rsd2^2)/sum((tst2 - mean(tst2))^2)
1 - sum(rsd2^2)/sum(tst2^2)
