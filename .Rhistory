install.packages("progress")
library(progress)
get_org_info <- function(id){
resp <- read_html(str_c(url, id))
html_table(resp)[[2]] |>
qDT() |>
dcast(. ~ X1, value.var = "X2") |>
fselect(-1)
pb$tick()
}
pb <- progress_bar$new(total = 20)
system.time(
res <- lapply(1:20, possibly(get_org_info, otherwise = NULL)) |>
rbindlist(use.names = TRUE, fill = TRUE, idcol = "id")
)
