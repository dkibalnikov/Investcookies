e_tooltip(trigger = "axis", digits = 0, textStyle = list(color = "white"), axisPointer = list(type = "line"),
formatter = htmlwidgets::JS("function (param) {
let param1 = param[0];
let param2 = param[1];
let param3 = param[2];
return [
'<b>Месяц</b>: ' + param1.value[0] + '<hr size=1>',
'<b>Экспорт</b>: ' + Math.round(param1.value[1]) + ' млрд.$' + '<br/>',
'<b>Импорт</b>: ' + Math.round(param2.value[1]) + ' млрд.$' + '<br/>',
'<b>Баланс</b>: ' + Math.round(param3.value[1]) + ' млрд.$' + '<br/>',
].join('');}")) %>%
