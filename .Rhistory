direct_invest %>%
filter(country %in% fcs_invers_countries) %>%
ggplot(aes(date_qtr, value_cs, fill = reorder(country, value_cs))) +
annotate("text_npc", npcx = .5, npcy = .5, label = "InvestCookies.ru",
color = "#1D1E20", alpha = .9, size = 15) +
geom_col(alpha = .5) +
scale_y_continuous(labels = scales::label_comma(prefix = "$")) +
zoo::scale_x_yearqtr(format = "%yQ%q", n = 10, limits = c(2001, 2022)) +
scale_fill_manual(values = my_pal, label = ~str_wrap(., 15)) +
theme(legend.position = "bottom") +
labs(fill = "", title = "Объем привлечений прямых инвестиций", y = "Привлечения, млн.долл.",
x = "Год и квартал")
