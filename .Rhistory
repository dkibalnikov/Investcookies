group_by(Год, `Направление перемещения`, oil_grp) %>%
summarise(trade = sum(`Стоимость, долл. США`)*1e-9) %>%
mutate(part = trade/sum(trade)) %>%
ungroup()
im <- filter(imex, `Направление перемещения` == "Импорт") %>%
group_by(Год, `Направление перемещения`, oil_grp) %>%
summarise(trade = sum(`Стоимость, долл. США`)*1e-9) %>%
mutate(part = trade/sum(trade)) %>%
ungroup()
