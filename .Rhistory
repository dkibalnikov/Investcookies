mdl2 <- filter(df,  name %in% mdl1$model$name) |> lm(data=_, log(inv) ~ name:profit + 0 + name:profit_lg+year)
#mdl2$coefficients[2] <- 0 # escape lag profit since oil production is not affected
mdl3 <- filter(df,  name %in% mdl2$model$name) |>  lm(data=_, log(value_add) ~ ind_cnsmp+inv+ind_cnsmp:name+0+year)
oil_prod_impact <- filter(df, name == "...10") |>
nest_by(year, .keep = TRUE) |>
mutate(ind_cnsmp_est = predict(mdl1, mutate(data, export = export*rate)),
ind_cnsmp_est = data$ind_cnsmp*rate+ind_cnsmp_est*(1-rate), # smooth adj
profit_est = data$profit*ind_cnsmp_est/data$ind_cnsmp,
inv_est = predict(mdl2, mutate(data, profit = profit_est))|> exp(),
inv_est = data$inv*rate+inv_est*(1-rate), # smooth adj
value_add_est = predict(mdl3, mutate(data, ind_cnsmp = ind_cnsmp_est, inv = inv_est))|> exp(),
value_add_est = data$value_add*rate+value_add_est*(1-rate) # smooth adj
) |>
reframe(data, ind_cnsmp_est, profit_est, inv_est, value_add_est) |>
select(name, year, отрасли_1, ind_cnsmp, profit, inv, value_add, ind_cnsmp_est, profit_est, inv_est, value_add_est, export)
