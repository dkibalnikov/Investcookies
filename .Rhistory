# Нано-модель трейдеров-везунчиков
n_traders <- 1e4
n_order <- 12e3
start_money <- 1000
profit <- 1.1
comission <- 0.0004
set.seed(1982)
mdl <- rbinom(n_traders, n_order, .5)
data.table(traders=mdl) |>
my_ggplot(aes(traders-n_order/2), alpha=.7) +
geom_histogram(binwidth = 20, col = "black") +
geom_density(aes(y = after_stat(20*count)), fill = my_pal[3], col =  my_pal[3], alpha = .5) +
labs(title = "Моделирование трейдеров-везунчиков", y = "Количество трейдеров", x = "Превышение удачных сделок над неудачными")
# Таблица трейдеров-везунчиков
data.table(`Сделки в плюсе` =  mdl[mdl > quantile(mdl, .99)] - n_order/2)[
, `Доходность, млн.руб` := round(profit^`Сделки в плюсе`*(1 + comission)^(-2*n_order)*start_money/1e6, 2)][
, `Доходность, %`:= round(`Доходность, млн.руб`*1e5, 2)][order(-`Доходность, млн.руб`)]  |>
