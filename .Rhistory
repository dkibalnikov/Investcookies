plot_position <- function(type, lvl){
lvl <- enquo(lvl)
dat <- filter(position, `0lvl` == "Обязательства" & `2lvl` == type  & !is.na(!!lvl) & period > as.Date("2014-01-01"))
filter(position, `0lvl` == "Активы" & `2lvl` == type  & !is.na(!!lvl) & period > as.Date("2014-01-01")) %>%
group_by(!!lvl) %>%
mutate(threshold = sum(value)) %>%
ungroup() %>%
filter(threshold > 1e4) %>%
ggplot(aes(x = date_qtr, y = value/1e6)) +
annotate("text_npc", npcx = .5, npcy = .5, label = "InvestCookies.ru", color = "#1D1E20", size = 18) +
geom_col(aes(fill = !!lvl), size = 2, alpha = .3) +
geom_col(data = dat, aes(y = -value/1e6, fill = !!lvl), size = 2, alpha = .3) +
geom_hline(yintercept = 0, col = "black") +
zoo::scale_x_yearqtr(format = "%yQ%q", n = 20) +
scale_y_continuous(labels = scales::label_dollar(prefix = "T$")) +
guides(x = guide_axis(n.dodge = 2), fill = guide_legend(ncol = 3)) +
scale_fill_manual(values = my_pal, labels = ~str_wrap(., 30)) +
labs(title = type, y = "<- Обязательсьва | Активы ->", x = "Год и квартал отчета", col = "", fill = "") +
theme(legend.position = "bottom", text = element_text(color = "gray60"),
axis.title.y.right = element_text(color = my_pal[4], vjust = 2),
axis.ticks.y.right  = element_line(color = my_pal[4]),
axis.text.y.right = element_text(color = my_pal[4]))
}
