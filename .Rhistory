mutate(qtr = cumsum(indx),
date_qtr = year + (qtr - 1)/4) %>%
select(country = ...1, year, qtr, value, date_qtr) %>%
filter(year != "2007" & qtr != 5 & str_detect(country, negate = TRUE, regex("СТРАН|ВСЕГО", ignore_case = TRUE))) %>%
replace_na(list(value = 0))
write_fst(direct_invest1, str_c(path, "data/direct_invest.fst"))
fcs_invers_countries <- direct_invest1 %>%
group_by(country) %>%
summarise(value = mean(value)) %>%
arrange(-value) %>%
slice(1:10) %>%
pull(country)
direct_invest1 %>%
filter(country %in% fcs_invers_countries) %>%
ggplot(aes(date_qtr, value, fill = country)) +
geom_col()
