tickers <- qs::qread("data/tickers.qs")
cor <- rollapply(tickers, width = 30, \(x) cor(x[,4], x[,10]), by.column=FALSE) %>% as.xts()
scale_cor <- 2
tickers_tbl <- as_tibble(tickers) %>%
mutate(date = index(tickers),
USDRUB.X.Close = if_else(USDRUB.X.Close < 1, USDRUB.X.Close*100, USDRUB.X.Close))
p1 <- ggplot(tickers_tbl, aes(date)) +
annotate("text_npc", npcx = .5, npcy = .5, label = "InvestCookies.ru", color = "#1D1E20", alpha = .9, size = 20) +
geom_line(aes(y = USDRUB.X.Close*scale_cor, col = "Курс рубля")) +
geom_line(aes(y = BZ.F.Close, col = "Цена Brent")) +
scale_y_continuous(sec.axis = sec_axis(~./scale_cor, name = "Курс ₽"), n.breaks = 10) +
scale_x_date(date_breaks = "1 year", date_labels = "%Y") +
scale_color_manual(values = c("Курс рубля" = my_pal[2], "Цена Brent" = my_pal[1])) +
theme(axis.title.y.right = element_text(colour = my_pal[2]), axis.title.y.left = element_text(colour = my_pal[1]), text = element_text(color = "gray60"),
axis.text.y.left = element_text(colour = my_pal[1]), axis.text.y.right = element_text(colour = my_pal[2]) ) +
labs(title = "Историческая зависимость курса рубля от стоимости нефти Brent", y = "Brent, $", fill = "", col = "", x = "")
p2 <- tibble(cor = cor, date = index(tickers)) %>%
as_tibble() %>%
ggplot(aes(date)) +
geom_col(aes(y = cor, fill = "Корреляция"), alpha = .5) +
geom_smooth(aes(y = cor, col = "Сглаженная корреляция"), size = .5) +
geom_hline(aes(yintercept = 1), col = my_pal[3], lty = 5) +
geom_hline(aes(yintercept = -1), col = my_pal[3], lty = 5) +
scale_x_date(date_breaks = "1 year", date_labels = "%Y") +
scale_color_manual(values = c("Сглаженная корреляция" = my_pal[5])) +
scale_fill_manual(values = c("Корреляция" = my_pal[3])) +
theme(legend.position = "top", text = element_text(color = "gray60"), axis.text.x = element_blank(), axis.title.y.left = element_text(colour = my_pal[3]),
axis.text.y.left = element_text(colour = my_pal[3])) +
labs(y = "Корреляция", fill = "", col = "", x = "", caption = "Источник: Yahoo Finance")
p1/p2 + plot_layout(guides = "collect", design = "
1#
1#
2#") & theme(legend.position = 'bottom')
