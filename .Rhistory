nms <- readxl::read_excel("data/tri-2018.xlsx", sheet = 2, range = "C5:C64", col_names = FALSE)[[1]] #%>% str_sub(1L, 60L) %>% str_wrap(30)
mtrxE <- readxl::read_excel("data/tri-2018.xlsx", sheet = 2, range = "D5:BK64", col_names = FALSE, col_types = rep("numeric", 60)) %>% as.matrix()
mtrxA <- readxl::read_excel("data/tri-2018.xlsx", sheet = 3, range = "D5:BK64", col_names = FALSE, col_types = rep("numeric", 60)) %>% as.matrix()
end_utlztn <- rowSums(mtrxE) - rowSums(mtrxA)
total_utlztn <- rowSums(mtrxE)
mtrxA_norm <- mtrxA %*% diag(1/total_utlztn) #get unit consumption/utilization
mtrxE_norm <- mtrxE %*% diag(1/total_utlztn) #get unit production
b_mtrx <- solve(mtrxE_norm - mtrxA_norm) #find solution matrix
dimnames(b_mtrx) <- list(nms, nms)
check <- ((b_mtrx %*% end_utlztn)*100/total_utlztn - 100) %>%
round(3)  %>%
as_tibble(rownames = "okved", .name_repair = ~"err_perc")
mltpl <- b_mtrx[, 36] %>%
enframe(name = "Отрасль", value = "Коэффициент") %>%
mutate(Доля = round(Коэффициент/sum(Коэффициент), 4), Коэффициент = round(Коэффициент, 2)) %>%
arrange(-Коэффициент)
datatable(mltpl, style = 'bootstrap4',  extensions = 'Responsive', options = list(pageLength = 10),
caption = "Структура потребления отрасли общественного питания в РФ") %>%
formatPercentage('Доля', 2) %>%
formatStyle('Доля',
background = styleColorBar(mltpl$Доля, '#2AD3D3'),
backgroundSize = '100% 90%',
backgroundRepeat = 'no-repeat',
backgroundPosition = 'center')
