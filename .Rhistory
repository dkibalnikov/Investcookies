filter(`РАЗДЕЛ I` == "Дефицит (-)/Профицит (+)") %>%
select(-(1:2)) %>%
t() %>%
.[, 1] %>%
as_tibble() %>%
mutate(year = c(rep(2011:2021, each = 12), rep(2022, 5)),
month = c(rep(1:12, times = 11), 1:5)) %>%
group_by(year) %>%
mutate(change = value - lag(value, default = 0),
status = if_else(month == 12, "декабрь", "прочее"))
ggplot(budget) +
annotate("text_npc", npcx = .5, npcy = .5, alpha = .9, size = 15, # для брендирования
label = "InvestCookies.ru", color = "#1D1E20") +
geom_histogram(aes(change, fill = status), alpha = .4, bins = 20) +
