library(blogdown)
serve_site()
library(plotly)
# Define container corners (wireframe)
container_size <- c(10, 10, 10)
cx <- c(0, 10)
cy <- c(0, 10)
cz <- c(0, 10)
# All combinations of corners
container_corners <- expand.grid(x = cx, y = cy, z = cz)
# Define edges of the container as pairs of point indices
container_edges <- rbind(
c(1,2), c(1,3), c(1,5),
c(2,4), c(2,6),
c(3,4), c(3,7),
c(4,8),
c(5,6), c(5,7),
c(6,8),
c(7,8)
)
# Create edge lines
edge_lines <- lapply(1:nrow(container_edges), function(i) {
idx <- container_edges[i, ]
list(
x = container_corners$x[idx],
y = container_corners$y[idx],
z = container_corners$z[idx],
type = 'scatter3d',
mode = 'lines',
line = list(color = 'black'),
showlegend = FALSE
)
})
# Define solid box inside
box_vertices <- expand.grid(
x = c(3, 7),
y = c(3, 7),
z = c(3, 7)
)
# Define faces using indices into `box_vertices`
faces <- list(
c(1, 2, 4, 3),
c(5, 6, 8, 7),
c(1, 2, 6, 5),
c(3, 4, 8, 7),
c(1, 3, 7, 5),
c(2, 4, 8, 6)
)
# Create mesh3d from faces
face_traces <- lapply(faces, function(face) {
list(
x = box_vertices$x[face],
y = box_vertices$y[face],
z = box_vertices$z[face],
i = c(0, 1, 2),
j = c(1, 2, 3),
k = c(2, 3, 0),
type = 'mesh3d',
opacity = 0.7,
color = 'blue',
showscale = FALSE
)
})
# Build plot
p <- plot_ly()
for (line in edge_lines) {
p <- add_trace(p, x = line$x, y = line$y, z = line$z, type = line$type, mode = line$mode, line = line$line, showlegend = FALSE)
}
for (face in face_traces) {
p <- add_trace(p,
type = face$type,
x = face$x, y = face$y, z = face$z,
i = face$i, j = face$j, k = face$k,
opacity = face$opacity,
color = face$color,
showscale = face$showscale
)
}
p <- layout(p,
scene = list(
xaxis = list(title = 'X'),
yaxis = list(title = 'Y'),
zaxis = list(title = 'Z')
)
)
p
