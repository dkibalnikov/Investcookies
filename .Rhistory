filter(account != "Резервные активы") %>%
ggplot(aes(x = date_qtr, y = value, col = part)) +
annotate("text_npc", npcx = .5, npcy = .5, label = "InvestCookies.ru", color = "#1D1E20", alpha = .9, size = 15) +
geom_line() +
scale_y_continuous(labels = scales::label_comma(prefix = "$")) +
zoo::scale_x_yearqtr(format = "%yQ%q", n = 6, limits = c(2001, 2022)) +
facet_grid(account ~ ., labeller = labeller(account = label_wrap_gen(10))) +
theme(legend.position = "bottom") +
labs(title = "Динамика активов и обязательств в разре статей",  x = "Год и квартал отчета",
y = "Активы и обязательства\nмлн. USD", col = "")
