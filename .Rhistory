# download.file(link_balance, "data/position.xlsx")
get_report <- function(set_report){
#set_report <- "balance"
if(set_report == "position"){
set_col_num <- 1
set_skip <- 3
}else{
if(set_report == "balance"){
set_col_num <- 2
set_skip <- 8
}else{
stop("Choose one option: 'position' or 'balance'")
}
}
report_xlsx <- list.files("data/") %>%
str_subset(set_report) %>%
str_subset("\\.xlsx")
report_formats <- xlsx_formats(str_c("data", "/", report_xlsx))
report_cells <- xlsx_cells(str_c("data", "/", report_xlsx), include_blank_cells = FALSE)
report_indent <- report_cells %>%
slice(-c(1:set_skip)) %>%
filter(!str_detect(character, "Остаток") | is.na(character)) %>%
filter(col == set_col_num) %>%
select(row, local_format_id) %>%
mutate(indent = report_formats$local$alignment$indent[local_format_id]) %>%
select(indent)
report_cells %>%
slice(-c(1:set_skip)) %>%
filter(!str_detect(character, "Остаток") | is.na(character)) %>%
behead(direction = "up", name = header) %>%
select(row, data_type, header, character, numeric) %>%
spatter(key = header) %>%
bind_cols(report_indent) %>%
select(-row, name = `<NA>`, indent) %>%
mutate(name = str_trim(name))
}
#get section hirarhy
get_lvl_value <- function(set_df){
lvls <- unique(set_df$indent) %>%
sort()
lvl_names <- str_c(lvls, "lvl")
df <- matrix(NA_character_, nrow = nrow(set_df), ncol = length(lvl_names)) %>%
as_tibble() %>%
set_names(lvl_names) %>%
bind_cols(set_df)
for(j in seq_along(lvls)){
if(df$indent[1] == lvls[j]){df[1, j] <- df$name[1]} else{df[1, j] <- NA}
for(i in 2:nrow(df)){
if(df$indent[i] == lvls[j]){df[i, j] <- df$name[i]}
else{
if(df$indent[i] > lvls[j]){
df[i, j] <- df[i-1, j]}
else{df[i, j] <- NA}
}
}
}
df
}
clean_report <- . %>%
mutate(across(!c(matches("lvl"), "name", "indent"), ~replace(., is.na(.) | . == "..." , "0") %>% as.numeric())) %>%
rowwise() %>%
mutate(total = sum(c_across(!c(matches("lvl"), "name", "indent")))) %>%
filter(abs(total) > 0.2) %>%
ungroup() %>%
select(-total)
balance <- get_report("balance") %>%
get_lvl_value() %>%
clean_report() %>%
janitor::remove_empty(which = "cols") %>%
select(matches("lvl"), name, indent, matches("квартал")) %>%
pivot_longer(-c(name, indent, matches("lvl")), names_to = "period") %>%
mutate(date_qtr = zoo::as.yearqtr(period, format = "%q квартал %Y г.")) %>%
arrange(date_qtr) %>%
group_by(across(matches("lvl")), name) %>%
mutate(value_csum = cumsum(value)) %>%
ungroup()
position <- get_report("position") %>%
get_lvl_value() %>%
clean_report() %>%
pivot_longer(-c(name, indent, matches("lvl")), names_to = "period") %>%
mutate(period = as.Date(period, format = "%Y-%m-%d"),
date_qtr = zoo::as.yearqtr(period)) %>%
# mutate(name = case_when(str_detect(name, "Чистая международная инвестиционная позиция") ~ "position",
#                         str_detect(name, "Активы") ~ "assets",
#                         str_detect(name, "Обязательства") ~ "liability",
#                         str_detect(name, "Резервные активы") ~ "reserve",
#                         TRUE ~ name)) %>%
group_by(name) %>%
mutate(chng = value - lag(value, default = 0)) %>%
ungroup()
balance_liability <- filter(balance, `2lvl` == "Портфельные инвестиции"  & `3lvl` == "Чистое принятие обязательств" & !is.na(`4lvl`) & is.na(`5lvl`) & str_detect(`4lvl`, "Участие|Долговые"))
position_liability <- filter(position, `0lvl` == "Обязательства" & `2lvl` == "Портфельные инвестиции" & !is.na(`4lvl`) & is.na(`5lvl`))
balance_asset <- filter(balance, `2lvl` == "Портфельные инвестиции"  & `3lvl` == "Чистое приобретение финансовых активов" & !is.na(`4lvl`) & is.na(`5lvl`) & str_detect(`4lvl`, "Участие|Долговые"))
position_asset <- filter(position, `0lvl` == "Активы" & `2lvl` == "Портфельные инвестиции" & !is.na(`4lvl`) & is.na(`5lvl`))
p1 <- balance_liability %>%
ggplot((aes(date_qtr))) +
annotate("text_npc", npcx = .5, npcy = .5, label = "InvestCookies.ru", color = "#1D1E20", alpha = .9, size = 20) +
scale_y_continuous(labels = scales::label_dollar(scale = 1e-3, prefix = "b$")) +
geom_col(aes(y = value_csum, fill = `4lvl`), position = "dodge", alpha = .5) +
geom_line(data = position_liability, aes(y = value, group = `4lvl`), alpha = .2, size = 3) +
geom_line(data = position_liability, aes(y = value, col = `4lvl`), lty = 5) +
theme(legend.position = "top") +
#guides(fill = guide_legend(ncol = 1)) +
