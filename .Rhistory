scale_fill_manual(values = c("Доля нефтигазовых доходов" = my_pal[4])) +
labs(title = "Динамика Brent в рублях и сальдо бюджета", subtitle = "со сдвигом на 2 месяца" , fill = "", col = "", x = "",
y =  str_glue("<span style = 'color: {my_pal[1]};'>Brent, руб.</span> | <span style = 'color: {my_pal[2]};'> Сальдо бюджета </span>")) +
theme(text = element_text(color = "gray60"), axis.title.y.left = element_markdown(),  axis.title.y.right = element_text(color = my_pal[4]))
p1 + p2 + p3 + p4 + plot_annotation(caption = "Источник: Минфин РФ", tag_levels = "A") +
plot_layout(guides='collect', design = "
113
