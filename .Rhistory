#CondMean=family$linkinv(as.matrix(terms)%*%t(as.matrix(Coef)))
CondMean=family$linkinv(as.matrix(newdata_prep)%*%t(as.matrix(Coef/10)))
rec_prob <- dbinom(matrix(rep(1,k),nrow=1), size = 1, prob = CondMean)
hl_mat(rec_prob, scale_color_viridis_c())
###Filtered Probabilities ####
fProb=matrix(data=0,nrow=nr,ncol=k)
margLik=matrix(data=0,nrow=nr,ncol=1)
#margLik[1,1]=sum ((P%*%matrix(object["iniProb"],ncol=1)) * t(Likel[1,,drop=FALSE]))
margLik[1,1]=sum ((P%*%matrix(object["iniProb"],ncol=1))* t(rec_prob[1,,drop=FALSE]))
#fProb[1,]= ((P%*%matrix(object["iniProb"],ncol=1))*t(Likel[1,,drop=FALSE]))/margLik[1,1]
fProb[1,]= ((P%*%matrix(c(1,1),ncol=1))*t(rec_prob[1,,drop=FALSE]))/margLik[1,1]
for (i in 2:nr){
# Mixtura de funcions
# MS filter margLikuation
margLik[i,1]=sum ((P%*%t(fProb[i-1,,drop=FALSE])) * t(rec_prob[i,,drop=FALSE]))
# MS filter Filter margLikuation for probabilities
fProb[i,]= ((P%*%t(fProb[i-1,,drop=FALSE])*t(rec_prob[i,,drop=FALSE]))/margLik[i,1])
}
# Negative sum of log Likelihood for fmincon (fmincon minimzes the function)
loglik=-sum(log(margLik[1:nr]))
as.data.table(fProb) |>
tfm(date = newdata$date) |>
melt("date") |>
ggplot() +
geom_line(aes(date, value)) +
facet_grid(variable ~.) +
scale_x_date(date_breaks = "5 years", labels = ~stri_replace(., regex = "-01-01", replacement = "")) +
geom_area(data = as.data.table(USRECD1, keep.rownames = "date")[date > as.Date("1970-01-01")], aes(date, y = USRECD), alpha = .2)
