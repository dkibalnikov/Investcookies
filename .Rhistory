mutate(brent2rub = BZ.F.Close*USDRUB.X.Close,
date = str_sub(date, 1L, 7L) %>% str_c("-15") %>% as.Date("%Y-%m-%d")) %>%
group_by(date) %>%
summarise(brent2rub = mean(brent2rub), .groups = "drop")
budget <- read_excel("data/fedbud_month.xlsx", sheet = "месяц", skip = 2)
deficit <- pivot_longer(budget, -(1:2)) %>%
mutate(date = as.Date(as.numeric(name), origin = "1900-01-01"), .before = 1) %>%
mutate(date = str_sub(date, 1L, 8L) %>% str_c("15") %>% as.Date("%Y-%m-%d")) %>%
select(date, type = 3, deficit = value) %>%
filter(type == "Дефицит (-)/Профицит (+)")
oil_part <- pivot_longer(budget, -(1:2)) %>%
mutate(date = as.Date(as.numeric(name), origin = "1900-01-01"), .before = 1) %>%
mutate(date = str_sub(date, 1L, 8L) %>% str_c("15") %>% as.Date("%Y-%m-%d")) %>%
select(date, type = 3, value) %>%
filter(type %in% c("Доходы, всего", "Нефтегазовые доходы")) %>%
pivot_wider(date, names_from = "type") %>%
mutate(prt = `Нефтегазовые доходы`/`Доходы, всего`)
jnd <- left_join(deficit, tickers_mnth, by = "date") %>%
mutate(across(3:4, ~scale(.)))
budget_start <- mutate(jnd, month = str_sub(date, 6L, 7L)) %>%
filter(month == "01") %>%
mutate(end = deficit + 0.2, start = deficit + 1)
mdl1 <- lm(data = jnd, deficit ~ 0 + brent2rub) %>% summary()
r1 <- str_c("R^2 == ", round(mdl1$adj.r.squared, 3))
mdl2 <- lm(data = mutate(jnd, deficit = lead(deficit, 2)), deficit ~ 0 + brent2rub) %>% summary()
r2 <- str_c("R^2 == ", round(mdl2$adj.r.squared, 3))
