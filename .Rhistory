geom_point() +
stat_smooth(method = "lm", formula = y ~ x, col = "darkcyan", fullrange = TRUE) +
stat_smooth(method = "lm", formula = y ~ 0 + x, col = "coral", fullrange = TRUE) +
geom_function(fun = \(x)(res1$coefficients[[1]] + res1$coefficients[[2]]*x), linetype = 5) +
geom_function(fun = \(x)(res2$coefficients[[1]]*x), linetype = 5)
