ggforce::facet_zoom(xlim =c(-.12, -.05), ylim = c(0, 4), horizontal = FALSE, zoom.size = .5) +
geom_segment(x = -.12, xend = -.05, y = 20, yend = 20, arrow = arrow(ends = "both", length = unit(0.1, "inches")),
size = .01, col = my_pal[3]) +
annotate(x = -.12, y = 70, geom = "label", label = "Зона\nчерных лебедей", hjust = 0,
col = "black", fill = my_pal[3], alpha = .5)
library(blogdown)
serve_site()
# Собственная функция ggplot
my_distr2 <-  function(bw, split = FALSE, ...){
list(
annotate("text_npc", npcx = .5, npcy = .5, alpha = .9, size = 15,
label = "InvestCookies.ru", color = "#1D1E20"),
if(split) #
geom_histogram(binwidth = bw, alpha = .9, ..., fill = "grey50", col = "grey50"),
if(split)
facet_grid(Ticker ~ ., labeller = labeller(Ticker = tick_names), scales = "free"),
geom_density(aes(y = after_stat(count*bw)), ...),
scale_fill_manual(values = my_pal, labels = tick_names),
scale_color_manual(values = my_pal, labels = tick_names),
scale_x_continuous(label = scales::label_percent()),
labs(x = "Изменения", y = "Наблюдения")
)
}
p3 <- ggplot(tickers1, aes(Return, fill = Ticker, col = Ticker)) +
my_distr2(position = "dodge", alpha = .2, bw = .005, size = .1) +
ggforce::facet_zoom(xlim =c(-.12, -.05), ylim = c(0, 4), horizontal = FALSE, zoom.size = .5) +
geom_segment(x = -.12, xend = -.05, y = 20, yend = 20, arrow = arrow(ends = "both", length = unit(0.1, "inches")),
size = .01, col = my_pal[3]) +
annotate(x = -.12, y = 70, geom = "label", label = "Зона\nчерных лебедей", hjust = 0,
col = "black", fill = my_pal[3], alpha = .5)
p4 <- ggplot(tickers1, aes(Return, fill = Ticker, col = Ticker)) +
my_distr2(position = "dodge", alpha = .2, bw = .005, size = .1, split = TRUE)
p3 + p4 + plot_layout(guides='collect') +
plot_annotation(title = "Распределения изменений котировок") &
theme(legend.position='bottom')
