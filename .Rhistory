View(est_POLY)
est_PLZL
est_PLZL$signal
est_PLZL[est_PLZL$signal] > 0
est_PLZL[est_PLZL$signal > 0]
est_PLZL[est_PLZL$signal > 0] |> nrow()
est_PLZL[est_PLZL$signal < 1] |> nrow()
est_GAZP[est_GAZP$signal < 1] |> nrow()
est_SBER[est_SBER$signal < 1] |> nrow()
est_YNDX[est_YNDX$signal < 1] |> nrow()
get_deposit <- function(est, rate = .06){nrow(est[est$signal > 0])*rate/365}
list(est_PLZL, est_POLY, est_SBER, est_GAZP, est_YNDX) |> lapply(get_deposit)
list(est_PLZL, est_POLY, est_SBER, est_GAZP, est_YNDX) |> lapply(get_deposit) |> unlist()
list(est_PLZL, est_POLY, est_SBER, est_GAZP, est_YNDX) |> lapply(get_deposit) |> unlist() |> mean()
list(est_PLZL, est_POLY, est_SBER, est_GAZP, est_YNDX) |> lapply(get_deposit) |> unlist() |> mean() |> round(2)
list(est_PLZL, est_POLY, est_SBER, est_GAZP, est_YNDX) |> lapply(get_deposit) |> unlist() |> mean() |> round(4)
