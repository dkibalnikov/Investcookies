mutate(oil_grp = case_when(str_detect(`ТНВЭД(4 знака)`, "НЕФТЬ СЫРАЯ") ~ "НЕФТЬ СЫРАЯ",
str_detect(`ТНВЭД(4 знака)`, "НЕФТЕПРОДУКТЫ") ~ "НЕФТЬ И НЕФТЕПРОДУКТЫ",
TRUE ~ "ПРОЧЕЕ"))
