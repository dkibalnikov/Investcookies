import altair as alt
import pandas as pd
import numpy as np
df = pd.DataFrame({
"date": pd.to_datetime("2025-04-01") + pd.to_timedelta(range(1, 101), 'D'),
df = pd.DataFrame({
"date": pd.to_datetime("2025-04-01") + pd.to_timedelta(range(1, 101), 'D'),
"value": np.random.exponential(0.7, 100)})
df
df
p1 = alt.Chart(df).mark_area(opacity=.6, color="seagreen").encode(x="date:T", y="value:Q", tooltip="value")
p2 = alt.Chart(df).mark_bar(opacity=.6, color="seagreen").encode(x=alt.X("value:Q", bin=True), y="count()", tooltip="count()")
