pTheta_norm = pTheta / sum(pTheta)
sum(pTheta_norm)
# Likelihood
pDataGivenTheta = choose(N, nGoal) * theta^nGoal * (1 - theta)^nMiss
# Denominator
## Unnormalized
pData_norm = sum(pDataGivenTheta * pTheta_norm)
## Normalized
pData = sum(pDataGivenTheta * pTheta)
# Posteriors
pThetaGivenData_1 <- pDataGivenTheta * pTheta_norm / pData_norm
pThetaGivenData_2 <- pDataGivenTheta * pTheta / pData
pThetaGivenData_1
#>  [1] 1.328754e-06 2.479775e-04 4.463594e-03 2.986887e-02 1.121137e-01
#>  [6] 2.324789e-01 2.801373e-01 2.257146e-01 1.016863e-01 1.328754e-02
