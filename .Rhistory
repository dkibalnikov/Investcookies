e_tooltip(trigger = "axis", digits = 0, textStyle = list(color = "white"), axisPointer = list(type = "line"),
formatter = htmlwidgets::JS("function (param) {
let param1 = param[0];
let param2 = param[1];
let param3 = param[2];
return [
'<b>Месяц</b>: ' + param1.value[0] + '<hr size=1>',
'<b>Великобритания</b>: ' + Math.round(param1.value[1]) + ' млрд.$' + '<br/>',
'<b>Еврозона</b>: ' + Math.round(param2.value[1]) + ' млрд.$' + '<br/>',
'<b>Прочие</b>: ' + Math.round(param3.value[1]) + ' млрд.$' + '<br/>',
].join('');}")) %>%
e_draft("InvestCookies.ru", size = "80px", opacity = 0.2) %>%
e_datazoom(type = "slider", start = 50, end =100) %>%
e_legend(top = 30) %>%
e_axis_labels(x = "Квартал") %>%
e_title("Торговый баланс Евросоюза", subtext = "Источник: Евростат")
read_fst("data/EU_trade_detailed.fst") %>%
group_by(zone, time) %>%
summarise(balance = sum(balance, na.rm = TRUE), .groups = "drop") %>%
complete(time, zone, fill = list(balance = NA)) %>% #
group_by(zone) %>%
e_chart(time) %>%
# e_bar(export, stack = "grp") %>%
# e_bar(import, stack = "grp") %>%
e_line(balance) %>%
e_color(my_pal) %>%
e_tooltip(trigger = "axis", digits = 0, textStyle = list(color = "white"), axisPointer = list(type = "line"),
formatter = htmlwidgets::JS("function (param) {
let param1 = param[0];
let param2 = param[1];
let param3 = param[2];
return [
'<b>Квартал</b>: ' + param1.value[0] + '<hr size=1>',
'<b>Великобритания</b>: ' + Math.round(param1.value[1]) + ' млрд.$' + '<br/>',
'<b>Еврозона</b>: ' + Math.round(param2.value[1]) + ' млрд.$' + '<br/>',
'<b>Прочие</b>: ' + Math.round(param3.value[1]) + ' млрд.$' + '<br/>',
].join('');}")) %>%
e_draft("InvestCookies.ru", size = "80px", opacity = 0.2) %>%
e_datazoom(type = "slider", start = 50, end =100) %>%
e_legend(top = 30) %>%
e_axis_labels(x = "Квартал") %>%
e_title("Торговый баланс Евросоюза", subtext = "Источник: Евростат")
read_fst("data/EU_trade.fst") %>%
#filter(month > as.Date("2006-01-01")) %>%
e_chart(month) %>%
e_bar(export, name = "Экспорт", color = my_pal[1], itemStyle = list(borderColor = NULL, opacity = .5)) %>%
e_bar(import, name = "Импорт", color = my_pal[2], itemStyle = list(borderColor = NULL, opacity = .5)) %>%
e_line(balance, name = "Баланс", itemStyle = list(borderColor = NULL, opacity = .5), color = my_pal[3]) %>%
e_tooltip(trigger = "axis", digits = 0, textStyle = list(color = "white"), axisPointer = list(type = "line"),
formatter = htmlwidgets::JS("function (param) {
let param1 = param[0];
let param2 = param[1];
let param3 = param[2];
return [
'<b>Месяц</b>: ' + param1.value[0] + '<hr size=1>',
'<b>Экспорт</b>: ' + Math.round(param1.value[1]) + ' млрд.$' + '<br/>',
