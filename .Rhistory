loans <- read_fst("data/loans.fst")
#countries_fcs <- filter(loans, year == "21" & abs(cs_balance) > 1000) %>% pull(country)
countries_fcs <- filter(loans, year == "21") %>% arrange(-cs_borrow) %>% slice(1:10) %>% pull(country)
# offshores <- c("КИПР", "ЛЮКСЕМБУРГ", "ИРЛАНДИЯ", "ВИРГИНСКИЕ ОСТРОВА, БРИТАНСКИЕ", "НИДЕРЛАНДЫ", "БАГАМЫ", "БЕРМУДЫ")
# filter(loans, country %in% countries_fcs) %>%
#   mutate(offshore = if_else(country %in% offshores, TRUE, FALSE)) %>%
#   group_by(offshore) %>%
#   summarise(Привлечено = sum(Сальдо))
p5 <- filter(loans, country %in% countries_fcs) %>%
ggplot(aes(x = year + 2000)) +
annotate("text_npc", npcx = .5, npcy = .5, label = "InvestCookies.ru",
color = "#1D1E20", alpha = .9, size = 15) +
geom_col(aes(y = cs_balance, fill = reorder(country, cs_balance)), alpha = .5) +
scale_y_continuous(labels = scales::label_comma(prefix = "$")) +
scale_x_continuous(n.breaks = 10) +
scale_fill_manual(values = my_pal, label = ~str_wrap(., 15)) +
theme(legend.position = "bottom") +
labs(fill = "", title = "Сальдо привлечений и погашений зарубежных займов", y = "Сальдо, млн.долл.", x = "Год")
p6 <- filter(loans, country %in% countries_fcs) %>%
ggplot(aes(x = year + 2000)) +
annotate("text_npc", npcx = .5, npcy = .5, label = "InvestCookies.ru",
color = "#1D1E20", alpha = .9, size = 15) +
geom_col(aes(y = cs_borrow, fill = reorder(country, cs_balance)), alpha = .5) +
scale_y_continuous(labels = scales::label_comma(prefix = "$")) +
scale_x_continuous(n.breaks = 10) +
scale_fill_manual(values = my_pal, label = ~str_wrap(., 15)) +
theme(legend.position = "bottom") +
labs(fill = "", title = "Объем привлечений зарубежных займов", y = "Привлечения, млн.долл.", x = "Год")
p5/p6 + plot_layout(guides = "collect")  &
theme(legend.position='bottom')
