left_join(select(oil_prod_impact, year, export), by = "year", suffix = c("", "_oil_prod")) |>
group_by(year) |>
mutate(oil_prod_cnsmp_prop = oil_prod_cnsmp/sum(oil_prod_cnsmp)) |>
ungroup() |>
mutate(ind_dmnd_est = ind_dmnd + export_oil_prod*(1-rate)*oil_prod_cnsmp_prop) |>
