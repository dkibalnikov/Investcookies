# library(ggplot2)
library(thematic)
# library(plotly)
library(echarts4r)
library(tidyverse)
library(quantmod)
library(data.table)
library(collapse)
library(DT)
thematic_rmd(bg = "#1D1E20", accent = "cyan", fg = "grey90", font = font_spec("Roboto"), sequential = firatheme::firaPalette(100), qualitative = firatheme::firaPalette(50))
sysfonts::font_add_google("Roboto")
# равт
e_common(font_family = "Verdana", theme = "infographic")
getSymbols("CL=F", from = "1995-01-01")
OPEC_prdctn <- readxl::read_excel("data/OPEC_oil_production.xlsx", range = "A3:BJ16")
oil_yr <- `CL=F`[, c("CL=F.Close", "CL=F.Volume")] |>
na_if(0) |>
na.locf() |>
split(f="years") |>
lapply(FUN=\(x)apply(x, MARGIN = 2, mean)) |>
set_names(2000:2021) %>%
map_dfr(~., .id = "year") |>
rename(oil_close = 2, oil_volume = 3)
OPEC_prdctn1 <- OPEC_prdctn %>%
rename(country = 1) %>%
pivot_longer(-country, names_to = "year", values_to = "production") #%>%
#left_join(WTI_yr, by="year")
OPEC_prdctn1 |>
filter(year >= 2000) |>
group_by(country) |>
e_charts(year) |>
e_bar(production, stack = "grp1", emphasis = list(focus = "series")) |>
e_data(oil_yr, year) |>
e_line(oil_close, x_index = 3, y_index = 3, name = "Цена нефти на закрытии торгов") |>
e_bar(oil_volume, x_index = 2, y_index = 2, name = "Объем торгов") |>
e_grid(height = "30%", top = "60%") |>
e_grid(height = "35%") |>
e_y_axis(gridIndex = 1, name = "Производство 1k барр.") |>
e_y_axis(index = 2, name = "Объем торгов, $") |>
e_y_axis(index = 3, name = "Цена, $") |>
e_x_axis(gridIndex = 1) |>
e_x_axis(index = 3, show = FALSE) |>
e_tooltip(trigger = "axis", digits = 0, textStyle = list(color = "white"), axisPointer = list(type = "line"),
formatter = e_tooltip_pointer_formatter("decimal", digits = 2)) |>
e_legend(type = "scroll", selector = TRUE) |>
e_title(text = "", subtext = "Данные OPEC, YahooFinance", right = 0, bottom = 5) |>
e_axis_pointer(link = list(xAxisIndex = 'all')) |>
e_draft("InvestCookies", size = "80px", opacity = 0.2)
